# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# App URL (used in email links and redirects)
# Set this to your real domain in production, e.g. https://viflow.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP / Email (optional — emails are skipped if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password

# Seeding (optional)
# The /api/seed endpoint requires an admin login and is blocked in production
# unless this is set to "true". Leave unset unless you intentionally need it.
# ALLOW_SEED=true
